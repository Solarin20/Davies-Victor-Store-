<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Davies Victor Store — Shop Clothes, Shoes & Accessories</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --orange:#F57224;
    --orange-dark:#D9600F;
    --dark:#1A1A1A;
    --grey:#6B6B6B;
    --line:#EAEAEA;
    --bg:#F4F4F4;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--dark);
    font-family:'Poppins', -apple-system, sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit; text-decoration:none;}
  .wrap{max-width:1200px; margin:0 auto; padding:0 20px;}

  .topbar{ background:var(--dark); color:#fff; font-size:0.78rem; padding:7px 0; text-align:center; }
  .topbar span{ color:var(--orange); font-weight:600; }

  header{ background:#fff; border-bottom:1px solid var(--line); position:sticky; top:0; z-index:50; }
  nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 20px; max-width:1200px; margin:0 auto; gap:20px;
  }
  .logo{ font-size:1.4rem; font-weight:800; display:flex; align-items:baseline; gap:3px; white-space:nowrap;}
  .logo .dot{color:var(--orange);}
  .nav-cta{
    background:var(--orange); color:#fff; padding:11px 20px;
    border-radius:4px; font-size:0.85rem; font-weight:600;
    white-space:nowrap; transition:background 0.2s;
    display:flex; align-items:center; gap:8px;
  }
  .nav-cta:hover{ background:var(--orange-dark); }
  @media (max-width:600px){ .logo{font-size:1.15rem;} .nav-cta{padding:9px 14px; font-size:0.78rem;} }

  .hero{
    background:linear-gradient(120deg, var(--orange), #ff9d52);
    color:#fff; padding:44px 20px; text-align:center;
  }
  .hero h1{ font-size:clamp(1.6rem, 4vw, 2.4rem); font-weight:800; margin-bottom:10px; }
  .hero p{ font-size:1rem; opacity:0.95; max-width:520px; margin:0 auto 22px; }
  .hero-cta{
    display:inline-flex; align-items:center; gap:8px;
    background:#fff; color:var(--orange-dark); font-weight:700;
    padding:13px 26px; border-radius:4px; font-size:0.92rem;
    transition:transform 0.15s;
  }
  .hero-cta:hover{ transform:translateY(-2px); }

  .cat-strip{ background:#fff; border-bottom:1px solid var(--line); padding:14px 0; overflow-x:auto; }
  .cat-strip-inner{ display:flex; gap:10px; padding:0 20px; max-width:1200px; margin:0 auto; }
  .cat-chip{
    background:var(--bg); border:1px solid var(--line); padding:8px 16px;
    border-radius:20px; font-size:0.8rem; font-weight:600; white-space:nowrap; color:var(--grey);
  }
  .cat-chip.active{ background:var(--orange); color:#fff; border-color:var(--orange); }

  .section{ padding:36px 20px; max-width:1200px; margin:0 auto; }
  .section-title{ display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
  .section-title h2{ font-size:1.25rem; font-weight:700; }
  .section-title .bar{ width:4px; height:20px; background:var(--orange); display:inline-block; margin-right:8px; vertical-align:middle; border-radius:2px;}

  .product-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(190px,1fr)); gap:16px; }
  .product-card{
    background:#fff; border:1px solid var(--line); border-radius:8px; overflow:hidden;
    display:flex; flex-direction:column; transition:box-shadow 0.2s, transform 0.2s;
  }
  .product-card:hover{ box-shadow:0 8px 22px rgba(0,0,0,0.08); transform:translateY(-3px); }
  .product-img{ position:relative; width:100%; aspect-ratio:1/1; background:#f0f0f0; overflow:hidden; }
  .product-img img{ width:100%; height:100%; object-fit:cover; display:block; }
  .badge{
    position:absolute; top:9px; left:9px; background:var(--orange); color:#fff;
    font-size:0.62rem; font-weight:700; padding:4px 8px; border-radius:3px; letter-spacing:0.02em;
  }
  .product-body{ padding:12px 13px 14px; display:flex; flex-direction:column; flex-grow:1; }
  .product-cat{ font-size:0.66rem; text-transform:uppercase; letter-spacing:0.04em; color:var(--grey); font-weight:600; margin-bottom:4px; }
  .product-name{ font-size:0.86rem; font-weight:600; margin-bottom:8px; flex-grow:1; line-height:1.35; }
  .product-price{ font-size:1.02rem; font-weight:800; color:var(--dark); margin-bottom:10px; }
  .order-btn{
    display:block; text-align:center; background:var(--orange); color:#fff;
    font-size:0.8rem; font-weight:700; padding:10px; border-radius:5px; transition:background 0.2s;
  }
  .order-btn:hover{ background:var(--orange-dark); }

  .why-section{ background:#fff; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .why-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:1px; max-width:1200px; margin:0 auto; }
  .why-card{ padding:28px 20px; text-align:center; }
  .why-card .icon{ font-size:1.6rem; margin-bottom:10px; }
  .why-card h3{ font-size:0.92rem; font-weight:700; margin-bottom:6px; }
  .why-card p{ font-size:0.8rem; color:var(--grey); }
  @media (max-width:700px){ .why-grid{grid-template-columns:1fr;} .why-card{border-bottom:1px solid var(--line);} }

  .contact-section{ background:var(--dark); color:#fff; text-align:center; padding:48px 20px; }
  .contact-section h2{ font-size:1.4rem; font-weight:800; margin-bottom:10px; }
  .contact-section p{ color:#ccc; margin-bottom:26px; }
  .contact-grid{ display:flex; justify-content:center; gap:16px; flex-wrap:wrap; margin-bottom:28px; }
  .contact-card{ background:#2a2a2a; padding:18px 24px; border-radius:8px; min-width:220px; text-align:left; }
  .contact-label{ font-size:0.68rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--orange); font-weight:700; margin-bottom:6px; }
  .contact-value{ font-size:1.05rem; font-weight:700; }
  .contact-section .hero-cta{ background:var(--orange); color:#fff; }
  .contact-section .hero-cta:hover{ background:var(--orange-dark); }

  footer{ background:#111; color:#999; text-align:center; padding:22px 20px; font-size:0.8rem; }
  footer strong{ color:#fff; }
</style>
</head>
